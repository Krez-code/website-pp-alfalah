generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id             Int            @id @default(autoincrement())
  fullName       String
  email          String         @unique
  password       String
  phone          String?
  role           Role           @relation(fields: [roleId], references: [id])
  roleId         Int
  santri         Santri?        @relation(fields: [santriId], references: [id])
  santriId       Int?           @unique
  waliSantri     WaliSantri?    @relation(fields: [waliSantriId], references: [id])
  waliSantriId   Int?           @unique
  guru           Guru?          @relation(fields: [guruId], references: [id])
  guruId         Int?           @unique
  notifications  Notification[]
  activityLogs   ActivityLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Santri {
  id               Int             @id @default(autoincrement())
  fullName         String
  nik              String          @unique
  nisn             String          @unique
  birthPlace       String
  birthDate        DateTime
  gender           String
  address          String
  photoUrl         String?
  user             User?
  waliSantri       WaliSantri?     @relation(fields: [waliSantriId], references: [id])
  waliSantriId     Int?
  pendaftaran      Pendaftaran?
  tagihan          Tagihan[]
  nilai            Score[]
  suratIzin        SuratIzin[]
  dokumen          Document[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model WaliSantri {
  id            Int      @id @default(autoincrement())
  fullName      String
  phone         String
  job           String
  address       String
  user          User?    
  santri        Santri[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Guru {
  id        Int      @id @default(autoincrement())
  fullName  String
  subject   String
  email     String   @unique
  phone     String?
  user      User?    
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pendaftaran {
  id               Int              @id @default(autoincrement())
  santri           Santri           @relation(fields: [santriId], references: [id])
  santriId         Int              @unique
  fatherName       String
  motherName       String
  phone            String
  fatherJob        String
  motherJob        String
  schoolOrigin     String
  educationLevel   String
  documents        RegistrationFile?
  status           String           @default("pending")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model RegistrationFile {
  id             Int          @id @default(autoincrement())
  pendaftaran    Pendaftaran  @relation(fields: [pendaftaranId], references: [id])
  pendaftaranId  Int          @unique
  kkUrl          String?
  birthCertificateUrl String?
  parentIdCardUrl String?
  photoUrl       String?
  createdAt      DateTime     @default(now())
}

model Gallery {
  id          Int      @id @default(autoincrement())
  category    String
  title       String
  imageUrl    String
  publishedAt DateTime @default(now())
}

model Agenda {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  type        String
  date        DateTime
  startTime   String
  endTime     String
  location    String
  createdAt   DateTime @default(now())
}

model Tagihan {
  id        Int      @id @default(autoincrement())
  santri    Santri   @relation(fields: [santriId], references: [id])
  santriId  Int
  type      String
  amount    Float
  dueDate   DateTime
  status    String   @default("unpaid")
  payments  Payment[]
  createdAt DateTime @default(now())
}

model Payment {
  id         Int      @id @default(autoincrement())
  tagihan    Tagihan  @relation(fields: [tagihanId], references: [id])
  tagihanId  Int
  amount     Float
  paidAt     DateTime @default(now())
  method     String
  receiptUrl String?
  status     String   @default("paid")
}

model Score {
  id         Int      @id @default(autoincrement())
  santri     Santri   @relation(fields: [santriId], references: [id])
  santriId   Int
  category   String
  subject    String
  value      Float
  semester   String
  ranking    Int?
  recordedAt DateTime @default(now())
}

model SuratIzin {
  id           Int      @id @default(autoincrement())
  santri       Santri   @relation(fields: [santriId], references: [id])
  santriId     Int
  className    String
  leaveDate    DateTime
  returnDate   DateTime
  reason       String
  status       String   @default("pending")
  pdfUrl       String?
  qrCodeUrl    String?
  createdAt    DateTime @default(now())
}

model Document {
  id        Int      @id @default(autoincrement())
  santri    Santri   @relation(fields: [santriId], references: [id])
  santriId  Int
  type      String
  title     String
  url       String
  createdAt DateTime @default(now())
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  publishedAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}